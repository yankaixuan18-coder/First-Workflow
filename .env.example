# Microsoft Edge browser settings
# Set this to your actual Edge User Data directory path.
# IMPORTANT: Close all Edge windows before running the tool.
CHROME_USER_DATA_DIR=C:\Users\YourName\AppData\Local\Microsoft\Edge\User Data
CHROME_PROFILE=Default

# Optional API provider keys (not needed for data collection)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
